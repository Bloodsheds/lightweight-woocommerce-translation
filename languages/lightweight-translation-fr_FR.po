msgid_plural "%d more texts are the same as WooCommerce or theme texts: they use that translation, so they are not listed here."
msgstr[0] "%d autre texte est identique à un texte WooCommerce ou du thème : il utilise sa traduction et n’est pas répété ici."
msgstr[1] "%d autres textes sont identiques à des textes WooCommerce ou du thème : ils utilisent leurs traductions et ne sont pas répétés ici."

msgid "%d orphan translations deleted."
msgstr "%d traductions sans contenu associé supprimées."

msgid "%d page could not be read"
msgid_plural "%d pages could not be read"
msgstr[0] "%d page n’a pas pu être vérifiée"
msgstr[1] "%d pages n’ont pas pu être vérifiées"

