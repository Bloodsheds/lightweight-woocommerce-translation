msgstr "%d textes conservés dans la langue originale."

msgid "%d texts typed in settings and widgets found."
msgstr "%d textes trouvés dans les réglages et les widgets."

msgid "%d to do"
msgstr "%d à traduire"

msgid "%d translation saved."
msgid_plural "%d translations saved."
msgstr[0] "%d traduction enregistrée."
msgstr[1] "%d traductions enregistrées."

msgid "%d translations deleted."
msgstr "%d traductions supprimées."

msgid "%d translations marked as still correct."
msgstr "%d traductions marquées comme toujours correctes."

msgid "%d translations removed."
msgstr "%d traductions retirées."

msgid "%d translations saved."
msgstr "%d traductions enregistrées."

msgid "%d untranslated texts deleted."
msgstr "%d textes non traduits supprimés."

msgid "%d variation"
msgid_plural "%d variations"
msgstr[0] "%d variation"
msgstr[1] "%d variations"

msgid "%d visible"
msgid_plural "%d visible"
msgstr[0] "%d visibles"
msgstr[1] "%d visibles"

msgid "%pages pages selected · about %min min"
msgstr "%pages pages sélectionnées · environ %min min"

msgid "%s item"
msgid_plural "%s items"
msgstr[0] "%s contenu"
msgstr[1] "%s contenus"

msgid "%s translation reset. The page cache of every language was cleared."
msgstr "Traduction %s réinitialisée. Le cache des pages a été vidé dans toutes les langues."

msgid "%s translation saved."
msgstr "Traduction %s enregistrée."

msgid "%s: the original was edited, check the translation"
msgstr "%s : l’original a changé, vérifiez la traduction"

msgid "(attribute values)"
msgstr "(valeurs des attributs)"

msgid "(copy it and send it when something does not work)"
msgstr "(à copier et transmettre en cas de problème)"

msgid "(hidden until opened: menu, tab, accordion or popup)"
msgstr "(masqué tant que le menu, l’onglet, l’accordéon ou la fenêtre ne sont pas ouverts)"

msgid "(who your visitors are, tone, words never to translate — added to the prompt)"
msgstr "(public, ton, mots à ne jamais traduire — ajoutés aux consignes)"

msgid "+ %d text shared with WooCommerce or the theme (translated there)"
msgid_plural "+ %d texts shared with WooCommerce or the theme (translated there)"
msgstr[0] "+ %d texte partagé avec WooCommerce ou le thème, traduit à cette source"
msgstr[1] "+ %d textes partagés avec WooCommerce ou le thème, traduits à cette source"

msgid "+ A text of this page is missing? Add it"
msgstr "+ Un texte manque sur cette page ? Ajoutez-le"

msgid "/fr/, /en/… Translated slug of every item, translated words like product-category."
msgstr "/fr/, /en/… Adresse de chaque contenu et mots des URL traduisibles, comme product-category."

msgid "1. Download the texts to translate"
msgstr "1. Télécharger les textes à traduire"

msgid "1. Translate your content"
msgstr "1. Traduire vos contenus"

msgid "2. Import the translated file"
msgstr "2. Importer le fichier traduit"

msgid "2. Translate your tools"
msgstr "2. Traduire vos outils"

msgid "3. Check your site"
msgstr "3. Vérifier votre site"

msgid "<strong>In a menu</strong> (recommended): <a href=\"%s\">Appearance › Menus</a>, box \"Language selector\" › Add to menu. Then choose a dropdown or a bulleted list in the menu item settings."
msgstr "<strong>Dans un menu</strong> (recommandé) : <a href=\"%s\">Apparence › Menus</a>, encadré « Sélecteur de langue » › Ajouter au menu. Le style du thème est utilisé automatiquement ; vous pouvez aussi choisir une liste à puces dans les réglages de l’élément."

msgid "A title, button, message…"
msgstr "Un titre, un bouton, un message…"

msgid "A → Z"
msgstr "A → Z"

msgid "AJAX, API & JSON"
msgstr "AJAX, API et JSON"

