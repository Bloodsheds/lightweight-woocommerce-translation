msgstr "Activés : leurs textes sont maintenant dans la liste."

msgid "Every page (header, footer, menus, mini-cart)"
msgstr "Toutes les pages (en-tête, pied de page, menus, mini-panier)"

msgid "Everything (including texts already translated)"
msgstr "Tout, y compris les textes déjà traduits"

msgid "Everything here is translated. 🎉"
msgstr "Tout est traduit ici. 🎉"

