msgstr "Project-Id-Version: Lightweight Translation 0.42.0\nLanguage: fr_FR\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=2; plural=(n > 1);\nX-Domain: lightweight-translation\n"

msgid "\"Hidden\": the language is not in the switcher nor in hreflang tags, and visitors are sent back to the original. Logged-in editors can still open it to check the translation before publishing it."
msgstr "« Masquée » : la langue n’apparaît ni dans le sélecteur ni dans les balises hreflang. Les visiteurs voient la version originale. Les éditeurs connectés peuvent vérifier la traduction avant sa publication."

msgid "\"Language\" selector above the fields + Translations box below the editor."
msgstr "Sélecteur de langue au-dessus des champs et encadré Traductions sous l’éditeur."

msgid "\"Translations\" column in Pages / Posts / Products lists"
msgstr "Colonne « Traductions » dans les listes de pages, articles et produits"

msgid "%1$d / %2$d translated"
msgstr "%1$d / %2$d traduits"

msgid "%1$d more text comes from plugins / themes not enabled for translation: %2$s."
msgid_plural "%1$d more texts come from plugins / themes not enabled for translation: %2$s."
msgstr[0] "%1$d autre texte provient d’un outil dont la traduction n’est pas activée : %2$s."
msgstr[1] "%1$d autres textes proviennent d’outils dont la traduction n’est pas activée : %2$s."

msgid "%1$d of %2$d texts translated · %3$d to review"
msgstr "%1$d textes traduits sur %2$d · %3$d à vérifier"

msgid "%1$d pages already checked · last check %2$s ago"
msgstr "%1$d pages déjà vérifiées · dernière vérification il y a %2$s"

