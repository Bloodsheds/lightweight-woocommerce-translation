msgid "%d text removed."
msgid_plural "%d texts removed."
msgstr[0] "%d texte retiré."
msgstr[1] "%d textes retirés."

msgid "%d texts can be translated again."
msgstr "%d textes peuvent de nouveau être traduits."

msgid "%d texts deleted."
msgstr "%d textes supprimés."

