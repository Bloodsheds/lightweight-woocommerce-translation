msgstr "%1$d textes à vérifier sur cette page, encadrés en rouge (%2$d masqués dans les menus, onglets ou fenêtres)."

msgid "%1$d translations deleted for %2$s."
msgstr "%1$d traductions supprimées pour %2$s."

msgid "%1$s: %2$d pages to review, %3$d without identical texts"
msgstr "%1$s : %2$d pages à vérifier, %3$d sans texte identique"

